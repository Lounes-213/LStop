{
  "name": "timizar-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers + Durable Objects backend for Timizar ride-hailing platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply timizar-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply timizar-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.3.11",
    "jose": "^5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wrangler": "^3.57.0"
  }
}
